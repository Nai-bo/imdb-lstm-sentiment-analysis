{
  "data_source": "IMDb aclImdb train/pos and train/neg",
  "source_reviews": 25000,
  "split": {
    "train": 20000,
    "validation": 2500,
    "test": 2500,
    "ratio": [0.8, 0.1, 0.1],
    "split_seed": 42
  },
  "reproduction_control": {
    "seed": 42,
    "dataloader_generator_seed": 42,
    "cudnn_deterministic": true,
    "cudnn_benchmark": false
  },
  "preprocessing": {
    "html_cleaner": "BeautifulSoup html.parser",
    "lowercase": true,
    "regex_keep": "[a-z\\s]",
    "tokenizer": "nltk.word_tokenize",
    "stopwords": "nltk english stopwords",
    "vocab_source": "train split only",
    "max_vocab_size": 10000,
    "special_tokens": ["<pad>", "<unk>"]
  },
  "model": {
    "embedding_dim": 300,
    "lstm_layers": 1,
    "bidirectional": false,
    "hidden_dim": 512,
    "dropout": 0.5,
    "output_dim": 2,
    "batch_first": true
  },
  "training": {
    "epochs": 10,
    "batch_size": 32,
    "loss": "CrossEntropyLoss",
    "optimizer": "Adam",
    "learning_rate": 0.0008,
    "evaluation_model": "last epoch",
    "padding_handling": "padding enters LSTM"
  },
  "embedding_experiment": {
    "random": {
      "initialization": "random",
      "trainable": true
    },
    "glove": {
      "initialization": "glove.6B.300d.txt",
      "trainable": false
    }
  }
}
